; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vending machine"
config/version="dev 4"
run/main_scene="uid://dol476noyi00q"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://bulusrtjutify"

[autoload]

SaveManager="*res://common/autoload/save_manager.gd"
SettingsManager="*res://common/autoload/settings_manager.gd"
AchievementsManager="*res://common/autoload/achievements_manager.gd"
Globals="*res://common/autoload/globals.gd"
LevelManager="*res://common/autoload/level_manager.gd"
GuiManager="*res://common/autoload/gui_manager.gd"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="keep_height"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "pink",
"res://common/": "gray",
"res://debug/": "red",
"res://entities/": "blue",
"res://environment/": "purple",
"res://gui/": "green",
"res://levels/": "orange"
}

[filesystem]

import/blender/enabled=false

[global_group]

player=""
item=""
persistent=""

